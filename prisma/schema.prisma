// Timchenko Art — Prisma schema
// Postgres (Supabase / Neon). Run `npx prisma migrate dev` after editing.
//
// Supabase note: DATABASE_URL should be the pooled connection (port 6543,
// pgbouncer) — used for normal app queries. DIRECT_URL should be the direct
// connection (port 5432) — Prisma needs this for migrations, since
// migrations don't work through the pgbouncer pooler. Get both from
// Supabase dashboard → "Connect" button → ORMs → Prisma.
// (Neon doesn't need directUrl — if using Neon, DATABASE_URL alone is fine,
// just set DIRECT_URL to the same value.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN   // You — full access: finances, commissions, settings
  ARTIST  // Marina — sees orders, updates status, uploads progress photos
}

/// Availability of a painting in the catalog (independent from any one order,
/// since a painting can be "in progress" before it's ever attached to an order).
enum ProductStatus {
  AVAILABLE    // "Готова" — finished, listed, purchasable
  IN_PROGRESS  // "В процесі" — being painted, visible but not yet purchasable
  SOLD         // "Продано" — attached to a PAID+ order, hidden from checkout
}

/// Order state machine, in strict forward order.
enum OrderStatus {
  PREVIEW       // Client viewing a preview, cart/checkout not yet paid
  PAID          // Payment confirmed via webhook
  PAINTING      // Marina is actively painting the piece
  DRYING        // Painting finished, curing before varnish/packing
  READY_TO_SHIP // Dry, varnished, packed — waiting to hand off to courier
  SHIPPED       // Tracking number added
  DELIVERED     // Client confirmed receipt; artist commission released
}

enum PaymentProvider {
  STRIPE       // primary — card, Apple Pay, Google Pay, PayPal (wallets/PayPal are switched on in the Stripe Dashboard, not in code)
  NOWPAYMENTS  // crypto — offered as a customer-chosen alternative
  CRYPTOMUS
  MONOBANK
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

// ────────────────────────────────────────────────────────────
// Core models
// ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Progress photos uploaded by the artist for a given order
  uploadedProgressPhotos ProgressPhoto[]

  @@map("users")
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  /// Localized: { "uk": "...", "en": "...", "de": "...", "fr": "...", "ja": "..." }
  /// — one name per storefront language. Resolved via lib/localizedText.ts.
  title       Json
  /// Localized the same way as `title` — one description per storefront
  /// language, same fallback via lib/localizedText.ts.
  description Json
  status      ProductStatus @default(IN_PROGRESS)

  // Exclusive = never repeated and never printed: a one-of-a-kind commission, or an
  // existing painting that was withdrawn from sale for good by agreement with its
  // buyer. An exclusive painting can be bought once (if still AVAILABLE) and that's it.
  // Set it with POST /api/admin/products/<slug>/exclusive (or "exclusive": true in paintings.json).
  exclusive   Boolean       @default(false)

  widthCm  Int
  heightCm Int
  material String  @default("oilCanvas") // stable slug into productCard.materials.* in messages/*.json (see `theme` below for the same pattern)
  /// Stable, language-independent slug used for catalog filtering (see
  /// gallery.themes.* in messages/*.json for the translated label shown
  /// to visitors). Free text is still accepted — untranslated themes just
  /// display as-is (see FilterBar.tsx / product/[slug]/page.tsx).
  theme    String? // for catalog filtering

  priceEur Decimal @db.Decimal(10, 2)
  // Base currency is EUR — the artist sets and thinks in EUR, so that's
  // the single source of truth stored here. Every other displayed
  // currency (USD, UAH, GBP, JPY, ...) is a converted *display* value —
  // see lib/currency.ts.
  // Commission is a fixed global constant (20%), not per-product —
  // see ARTIST_COMMISSION_PCT in lib/constants.ts. Not stored here so
  // there is a single source of truth if it's ever revisited.

  // Object keys (RELATIVE, e.g. "paintings/<slug>/large-ab12cd34.webp") —
  // resolved to URLs by lib/media.ts. Legacy full URLs / "/paintings/x.jpg"
  // values are still tolerated there. Paintings are sold as PHYSICAL
  // canvases, so no file is ever delivered to a customer.
  previewImageKey String // ≤2000px WebP, public bucket (detail / modal / product page)
  thumbImageKey   String? // ≤900px WebP, public bucket (cards, carousels); null → falls back to previewImageKey
  originalImageKey String // full-res master, PRIVATE bucket — never sent to the browser
  processVideoKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[] // many: prints and repainted copies of a painting can be ordered any number of times; only ONE row (variant ORIGINAL) ever holds the existing painting - see OrderItem.reservedProductId

  @@index([status])
  @@map("products")
}

/// One order can hold several paintings at once (the "Мольберт" / easel —
/// pieces the customer has set aside before checking out). Each painting
/// The existing painting can still go to only one buyer (OrderItem.reservedProductId
/// is unique); prints and repainted copies can be ordered in any quantity.
model Order {
  id        String      @id @default(cuid())
  status    OrderStatus @default(PREVIEW)
  locale    String      @default("uk") // storefront language at checkout — used for every status-change email sent after this, since those fire from webhooks/admin actions with no request-scoped locale of their own

  items OrderItem[]

  customerEmail String
  customerName  String
  shippingAddress Json // { country, city, postalCode, line1, line2?, phone }

  amountEur            Decimal @db.Decimal(10, 2) // sum of all items' priceEur at time of order, EUR base
  platformCommissionEur Decimal @db.Decimal(10, 2) // your cut = amountEur * PLATFORM_COMMISSION_PCT (20%)
  artistPayoutEur       Decimal @db.Decimal(10, 2) // what the artist keeps = amountEur - platformCommissionEur (80%)
  // Both snapshotted once, when status → PAID, so a later price/rate change
  // never silently rewrites what's owed on an already-placed order.

  trackingNumber   String?
  trackingCarrier  String?

  // Money flow: ALL customer payments (Stripe, PayPal-via-Stripe, crypto) land
  // on the seller's (the artist's) own accounts. The 20% commission is paid to
  // the site operator by the artist afterwards, in a monthly batch against an
  // invoice — these two fields track that settlement per order.
  commissionSettled   Boolean   @default(false)
  commissionSettledAt DateTime?

  paidAt      DateTime? // set when status → PAID; its month decides which commission report the order is in
  deliveredAt DateTime? // set when status → DELIVERED; the 14-day return window counts from here

  payment         Payment?
  progressPhotos  ProgressPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("orders")
}

/// One painting within an order. productId is unique — a painting can be
/// in at most one (active) order's easel/checkout at a time, which is what
/// stops two customers from both buying the same one-of-a-kind piece.
///
/// ⚠️ Known gap, same as before this model existed: an abandoned PREVIEW
/// order (customer starts checkout, never pays) permanently reserves its
/// items unless someone deletes that order — there's no automatic
/// expiry/cleanup job yet. Worth adding before relying on this at scale.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // What exactly is being bought. One easel line can become several rows: oil
  // painting x3 of a painting that is still in stock = 1 ORIGINAL + 2 REPAINT.
  variant  OrderItemVariant @default(ORIGINAL)
  quantity Int              @default(1)

  // Reservation of the ONE physical painting. Set to productId for ORIGINAL
  // rows only (NULL for REPAINT / PRINT), and unique: Postgres allows many
  // NULLs but only one non-NULL per value, so two customers can never both
  // hold the same existing painting, while prints and repaints of it are
  // unlimited. (Replaces the old unique constraint on productId.)
  reservedProductId String? @unique

  priceEur Decimal @db.Decimal(10, 2) // UNIT price at the time of ordering (line total = priceEur x quantity)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("order_items")
}

enum OrderItemVariant {
  ORIGINAL // the existing physical painting - exactly one buyer; marks the product SOLD once paid
  REPAINT //  an additional hand-painted copy of the same painting, made to order (any quantity)
  PRINT //    canvas print at the flat price (any painting, any quantity; never changes product status)
}

model Payment {
  id       String          @id @default(cuid())
  orderId  String          @unique
  order    Order           @relation(fields: [orderId], references: [id])

  provider       PaymentProvider
  status         PaymentStatus @default(PENDING)
  providerRef    String        @unique // payment_id / invoice_id from the gateway
  rawWebhookPayload Json?      // last webhook body received, for audit/debug

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, status])
  @@map("payments")
}

/// Photos of a piece at a given production stage, uploaded by the artist
/// and visible to the customer in their order timeline.
model ProgressPhoto {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  imageKey String
  caption  String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@map("progress_photos")
}
