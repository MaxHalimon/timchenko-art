# Скопіюйте цей файл у .env (не .env.local) і заповніть реальними значеннями.
# Один файл .env працює і для Next.js (dev-сервер), і для Prisma CLI
# (migrate/db seed) — не тримайте окремий .env.local поруч, це лише
# джерело плутанини (Prisma CLI його все одно ігнорує).

# Database (Supabase or Neon Postgres)
# Supabase: get both from dashboard → "Connect" button → ORMs → Prisma.
#   DATABASE_URL = pooled connection (port 6543, pgbouncer) — used at runtime
#   DIRECT_URL   = direct connection (port 5432) — used by `prisma migrate`
# Neon: DATABASE_URL alone is fine, just set DIRECT_URL to the same value.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Public site URL, used to build callback/redirect URLs
NEXT_PUBLIC_SITE_URL="https://timchenko-art.com.ua"

# Keeps the site out of Google/etc. until you're ready to launch — both
# the <meta robots> tag and robots.txt respect this. Set to "true" only
# when you're actually ready to go live (age verification, legal pages,
# etc. all finalized).
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Stripe (primary — card, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# NOWPayments (secondary — crypto, customer-chosen option at checkout)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Cryptomus (if/when added as a second crypto provider)
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""

# Monobank for Business (phase 2)
MONOBANK_TOKEN=""

# EmailJS (contact form on /contacts, sends to maryna.timchenko.art@gmail.com).
# All three are safe to expose client-side — that's how EmailJS is designed.
# See EMAILJS_GUIDE.md at the project root for how to get these values.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# --- Order-status emails (server-side, sent TO customers) --------------
# Separate from EmailJS above, which only runs in the browser and only
# sends TO the artist (contact form). This is what sends "your order was
# paid / is being painted / shipped / etc." to the customer. Get an API
# key at https://resend.com — free tier is enough to start.
RESEND_API_KEY=""
EMAIL_FROM="Timchenko Art <orders@timchenko-art.com.ua>"

# --- Temporary admin API (see app/api/admin/orders/[id]/status) --------
# No admin UI/login exists yet — this lets you advance an order's status
# (and trigger the matching customer email) via a single authenticated
# POST request until a real admin panel is built. Pick any long random
# string; leave unset to disable the route entirely (returns 501).
ADMIN_API_SECRET=""

# S3-compatible storage for painting images
S3_PREVIEWS_BUCKET="timchenko-art-previews"
S3_ORIGINALS_BUCKET="timchenko-art-originals"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
