# Скопіюйте цей файл у .env (не .env.local) і заповніть реальними значеннями.
# Один файл .env працює і для Next.js (dev-сервер), і для Prisma CLI
# (migrate/db seed) — не тримайте окремий .env.local поруч, це лише
# джерело плутанини (Prisma CLI його все одно ігнорує).

# Database (Supabase or Neon Postgres)
# Supabase: get both from dashboard → "Connect" button → ORMs → Prisma.
#   DATABASE_URL = pooled connection (port 6543, pgbouncer) — used at runtime
#   DIRECT_URL   = direct connection (port 5432) — used by `prisma migrate`
# Neon: DATABASE_URL alone is fine, just set DIRECT_URL to the same value.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Public site URL, used to build callback/redirect URLs
# Domain assumed as tymchenko-art.com.ua — update once confirmed/registered.
NEXT_PUBLIC_SITE_URL="https://tymchenko-art.com.ua"

# Stripe (primary — card, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# NOWPayments (secondary — crypto, customer-chosen option at checkout)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Cryptomus (if/when added as a second crypto provider)
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""

# Monobank for Business (phase 2)
MONOBANK_TOKEN=""

# S3-compatible storage for painting images
S3_PREVIEWS_BUCKET="tymchenko-art-previews"
S3_ORIGINALS_BUCKET="tymchenko-art-originals"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
